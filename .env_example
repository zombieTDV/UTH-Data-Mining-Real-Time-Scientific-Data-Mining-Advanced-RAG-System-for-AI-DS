# ==============================================================================
# UTH Data Mining & Real-Time Scientific Advanced RAG Lakehouse Configuration
# Copy to .env and fill in real values. No secret has a default in code.
# ==============================================================================

# Object Storage: MinIO S3 (the only place pipelines persist data)
STORAGE_PROVIDER=minio
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY_ID=CHANGE_ME
MINIO_SECRET_ACCESS_KEY=CHANGE_ME
MINIO_BUCKET_NAME=uth-scientific-lakehouse

# Vector Database: Qdrant
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scientific_papers_gold

# Message Broker: RabbitMQ (AMQP 0-9-1). Inside Docker/Airflow use host.docker.internal.
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_URL=http://localhost:15672
RABBITMQ_QUEUE_INGEST=scientific_paper_ingest
RABBITMQ_QUEUE_DEAD=scientific_paper_ingest.dead
RABBITMQ_MAX_RETRIES=3

# Optional: backend telemetry endpoint (leave empty to disable)
BACKEND_BROADCAST_URL=http://localhost:8000/api/ingestion/broadcast

# arXiv Harvesting
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CV,cs.CL,stat.ML
ARXIV_REQUEST_DELAY_SECONDS=6.0
HARVESTER_USER_AGENT=UTH-Scientific-Harvester/2.0 (contact: you@example.com)

# Local Neural & Embedding Models (read-only)
EMBEDDING_MODEL_PATH=models/nomic-embed-text-v1.5

# Backend
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LLM_SERVICE_URL=http://localhost:9001/v1
OLLAMA_SERVICE_URL=http://localhost:11434/v1
DEEPEVAL_LOCAL_URL=http://localhost:9001/v1

# Airflow -> backend mining trigger
BACKEND_MINING_TRIGGER_URL=http://localhost:8000/api/mining/trigger
BACKEND_COMPACT_SILVER_URL=http://localhost:8000/api/ingestion/compact-silver

# Airflow REST API (backend monitors DAG runs and controls DAGs through it)
AIRFLOW_API_URL=http://localhost:8080/api/v1
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=CHANGE_ME

# Semantic Scholar (Tier 3 landmark ranking). Optional: without a key the shared pool rate-limits hard
SEMANTIC_SCHOLAR_API_KEY=

# Lakehouse disk budget (MinIO + Qdrant). Harvesters stop publishing once it is full
LAKEHOUSE_BUDGET_GB=20
EST_BYTES_PER_PAPER=160000
QDRANT_BYTES_PER_POINT=6500


# MongoDB (local docker mongo_service, auth enabled; both users can read & write)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASSWORD=CHANGE_ME
MONGO_USER=app_user
MONGO_PASSWORD=CHANGE_ME
MONGO_ADMIN_URI=mongodb://admin:CHANGE_ME@localhost:27017/?authSource=admin
MONGO_URI=mongodb://app_user:CHANGE_ME@localhost:27017/?authSource=admin
