# ==============================================================================
# Phase 1: Cào dữ liệu arXiv và lưu trữ vào Cloudflare R2 Bronze Lakehouse
# ==============================================================================

# Thông tin xác thực Cloudflare R2
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=uth-scientific-lakehouse

# Cấu hình cào arXiv
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CV,cs.CL,stat.ML
ARXIV_REQUEST_DELAY_SECONDS=3.0
DATA_RAW_DIR=data/raw
