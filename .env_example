# ==============================================================================
# Phase 2: Conference Ingestion (KDD, ICML, ICLR, NeurIPS) - Data Science venues
# ==============================================================================

# 4 conferences to crawl (comma-separated). Supported: KDD, ICML, ICLR, NeurIPS
# KDD: https://www.kdd.org/conferences
# ICML: https://icml.cc/
# ICLR: https://iclr.cc/Conferences/2026/index.html
# NeurIPS: https://neurips.cc/Conferences/2026/CallForPapers
CONFERENCE_SOURCES=KDD,ICML,ICLR,NeurIPS

# Year range (inclusive). Data Science papers from 2020 onwards.
CONFERENCE_YEAR_FROM=2020
CONFERENCE_YEAR_TO=2026

# Per-domain rate limits (req/sec). OpenAlex is polite; HTML scrape = conservative.
OPENALEX_RATE_LIMIT_RPS=10
OPENREVIEW_RATE_LIMIT_RPS=5
KDD_RATE_LIMIT_RPS=1
ICML_RATE_LIMIT_RPS=1
ICLR_RATE_LIMIT_RPS=1
NEURIPS_RATE_LIMIT_RPS=1

# Jitter (0.0 - 1.0). delay = base * (1 + random.uniform(-jitter, +jitter))
RATE_LIMIT_JITTER=0.3

# OpenAlex polite pool: required email for the "polite pool" (faster)
# https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=nhatva7980@ut.edu.vn

# Semantic Scholar Graph API (optional fallback). https://api.semanticscholar.org/
S2_API_KEY=

# OpenReview API (ICLR). https://api.openreview.net/
OPENREVIEW_USERNAME="Võ Anh Nhật"

# Crawler runtime tunables
CRAWLER_TIMEOUT_CONNECT=10
CRAWLER_TIMEOUT_READ=30
CRAWLER_TIMEOUT_TOTAL=120
CRAWLER_MAX_CONCURRENCY=4
CRAWLER_CIRCUIT_BREAKER_THRESHOLD=10
CRAWLER_CIRCUIT_BREAKER_COOLDOWN=600
CRAWLER_MAX_RETRIES=5
CRAWLER_DEAD_LETTER_DIR=data/dlq

# Storage prefix for Bronze layer (R2)
CONFERENCE_BRONZE_PREFIX=bronze/conferences
CONFERENCE_SILVER_PREFIX=silver/papers

# Schedule policy (advisory only - does NOT bypass rate limits)
CRAWLER_OFFPEAK_ENABLED=false
CRAWLER_OFFPEAK_START_HOUR=1
CRAWLER_OFFPEAK_END_HOUR=6

OPENALEX_API_KEY=J2ehq0lNo9tuzRrbgo6WND
OPENALEX_SUB_FIELDS=1203,1702,1703,1706,1707,1710,1711,1804,2207,2613,3309,3310
OPENALEX_DEDUP_MAX_OBJECTS_PER_YEAR = 100_000
OPENALEX_PER_PAGE = 100
OPENALEX_REQUESTS_PER_SECOND = 5
OPENALEX_TIMEOUT_SECONDS = 30.0
OPENALEX_MAX_RETRIES = 5
